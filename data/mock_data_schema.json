  "relationships": [
    { "from": "PurchaseDocumentLine", "to": "PurchaseDocument", "type": "belongsTo", "cardinality": "many-to-one", "via": "purchaseDocumentId" },
    { "from": "PurchaseDocumentLine", "to": "PurchaseRequirement", "type": "convertedFrom", "cardinality": "many-to-one", "via": "purchaseRequirementId" },
    { "from": "PurchaseDocumentLine", "to": "MaterialPlant", "type": "supplies", "cardinality": "many-to-one", "via": "materialPlantId" },
    { "from": "PurchaseDocument", "to": "Vendor", "type": "placedWith", "cardinality": "many-to-one", "via": "vendorId" },
    { "from": "PurchaseRequirement", "to": "MaterialPlant", "type": "requests", "cardinality": "many-to-one", "via": "materialPlantId" },
    { "from": "MaterialRequirements", "to": "MaterialPlant", "type": "demands", "cardinality": "many-to-one", "via": "materialPlantId" },
    { "from": "Vendor", "to": "MaterialPlant", "type": "approvedToSupply", "cardinality": "many-to-many", "via": "approvedForMaterials" }
  ],

  "scenario": {
    "title": "A confirmed delivery date slipped — assess the impact and decide what to do",
    "narrative": "On 2026-09-01 the vendor changed the confirmed delivery date of an open purchase order line (PDOC-4500001234-10) that supplies material MAT-8891 to plant 1010 (see event EVT-0006). The dataset also contains several other materials, plants, vendors and purchase orders that are operating normally. Using the objects, events, and relationships above, work out whether this change puts plant 1010 at risk of not meeting its near-term demand — and if so, by how much and what the best course of action is. All the facts you need are in the data; the analysis is up to you.",
    "note_to_candidate": "There is no single 'correct' answer, and the impact and the options are deliberately NOT pre-computed for you. A strong solution derives the risk from the records, discovers the realistic options the data supports, weighs their trade-offs (cost, lead time, reliability, priority), and produces a defensible recommendation backed by the evidence it used."
  }
}
