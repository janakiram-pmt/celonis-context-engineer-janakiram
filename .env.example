# Copy to .env and fill in. Never commit .env.

# Gemini API key (free tier: https://aistudio.google.com/apikey). Not needed for --offline.
GEMINI_API_KEY=your-gemini-api-key

# Optional: model id (default gemini-flash-latest).
GEMINI_MODEL=gemini-flash-latest

# Optional: Slack incoming webhook. Without it, the message is written to demo/slack_message.json.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
