        { "purchaseDocumentLineId": "PDOC-4500001240-10", "purchaseDocumentId": "PDOC-4500001240", "lineNumber": 10, "materialPlantId": "MP-1020-8891", "purchaseRequirementId": "PR-3002", "orderedQuantity": 100, "netPrice": 40.0, "requestedDeliveryDate": "2026-10-02", "confirmedDeliveryDate": "2026-10-02", "goodsReceiptQuantity": 0, "lineStatus": "Confirmed" },
        { "purchaseDocumentLineId": "PDOC-4500001250-10", "purchaseDocumentId": "PDOC-4500001250", "lineNumber": 10, "materialPlantId": "MP-1010-8892", "purchaseRequirementId": "PR-3003", "orderedQuantity": 300, "netPrice": 58.0, "requestedDeliveryDate": "2026-08-20", "confirmedDeliveryDate": "2026-08-20", "goodsReceiptQuantity": 300, "lineStatus": "Received" },
        { "purchaseDocumentLineId": "PDOC-4500001255-10", "purchaseDocumentId": "PDOC-4500001255", "lineNumber": 10, "materialPlantId": "MP-1020-7400", "purchaseRequirementId": "PR-3004", "orderedQuantity": 500, "netPrice": 8.5, "requestedDeliveryDate": "2026-09-19", "confirmedDeliveryDate": "2026-09-19", "goodsReceiptQuantity": 0, "lineStatus": "Confirmed" }
      ]
    }
  },

  "events": {
    "description": "A flat, append-only event log across objects. Each event references the object it belongs to via objectType + objectId. Replaying the events reconstructs each object's lifecycle. Most activity is routine; one event materially changes a commitment.",
    "schema": {
      "eventId": { "type": "string", "description": "Unique event identifier." },
      "objectType": { "type": "string", "description": "The object type the event belongs to." },
      "objectId": { "type": "string", "description": "The specific object instance the event belongs to." },
      "activity": { "type": "string", "description": "The business activity that occurred." },
      "timestamp": { "type": "string", "description": "When the activity occurred (ISO-8601 UTC)." },
      "attributes": { "type": "object", "description": "Optional activity-specific payload (e.g., old vs. new value)." }
    },
    "records": [
