      { "eventId": "EVT-0003", "objectType": "PurchaseDocumentLine", "objectId": "PDOC-4500001234-10", "activity": "Line Created", "timestamp": "2026-08-12T09:30:05Z", "attributes": { "orderedQuantity": 400 } },
